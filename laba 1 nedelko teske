**задание 5**




using System;
class Ex
{
    static void Main()
    {
      Console.Write("Введите R и h: ");
      string[] p=Console.ReadLine().Split(' ');
      double R = Convert.ToDouble(p[0]);
      double h = Convert.ToDouble(p[1]);
      double l = Math.Sqrt(R * R + h * h);
      double s = Math.PI * R * (R + l);
      double v = Math.PI * R * R * h / 3.0;
      Console.WriteLine($"Площадь поверхности: {s:F3}");
      Console.WriteLine($"Объём конуса: {v:F3}");

    }
}




